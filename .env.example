# Copy to .env and change every change-me value (the server refuses to start with them). Use letters and digits only in the password
# (it goes into a connection URL).
POSTGRES_PASSWORD=change-me
INVITE_CODE=change-me
# Production only: public domain that Caddy gets an HTTPS certificate for.
DOMAIN=wordbook.example.com
# For running the server on your machine (dev). Port 5434 = the compose db service.
DATABASE_URL=postgres://wordbook:change-me@localhost:5434/wordbook
